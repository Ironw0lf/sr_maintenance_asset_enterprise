<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sr_location_form_asset" model="ir.ui.view">
        <field name="name">sr.location.form.asset</field>
        <field name="model">sr.location</field>
        <field name="inherit_id" ref="sr_maintenance.view_sr_location_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" name="action_view_sr_asset"
                        icon="fa-money" invisible="not sr_asset_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Fixed Asset</span>
                        </div>
                    </button>
                </div>
            </div>
            <page name="equipments" position="after">
                <page string="🏦 Fixed Asset" name="sr_asset">
                    <group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="sr_asset_id"/>
                        </group>
                        <group invisible="not sr_asset_id">
                            <field name="asset_state" widget="badge"/>
                            <field name="asset_acquisition_date"/>
                            <field name="asset_original_value"/>
                        </group>
                    </group>
                    <div class="alert alert-info mt-2" role="alert" invisible="not sr_asset_id">
                        <i class="fa fa-info-circle"/> Current book value and the full depreciation
                        schedule are not shown here yet - use the "Fixed Asset" button above to see
                        them in Accounting.
                    </div>
                </page>
            </page>
        </field>
    </record>
</odoo>
