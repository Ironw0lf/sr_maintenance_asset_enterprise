<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sr_equipment_form_asset" model="ir.ui.view">
        <field name="name">sr.equipment.form.asset</field>
        <field name="model">sr.equipment</field>
        <field name="inherit_id" ref="sr_maintenance.view_sr_equipment_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_sr_asset"
                    icon="fa-money" invisible="not sr_asset_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Fixed Asset</span>
                    </div>
                </button>
            </div>
            <page name="notes" position="before">
                <page string="🏦 Fixed Asset" name="sr_asset">
                    <group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="sr_asset_id"/>
                        </group>
                        <group invisible="not sr_asset_id">
                            <field name="asset_state" widget="badge"/>
                            <field name="asset_acquisition_date"/>
                            <field name="asset_original_value"/>
                            <field name="asset_salvage_value"/>
                            <field name="asset_book_value"/>
                        </group>
                    </group>
                    <field name="asset_depreciation_move_ids" invisible="not sr_asset_id" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="name" widget="open_move_widget"/>
                            <field name="depreciation_value"/>
                            <field name="asset_depreciated_value"/>
                            <field name="asset_remaining_value"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
